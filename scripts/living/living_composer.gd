class_name LivingComposer
extends RefCounted
## Living Assets – builds the visual of an object from its VisualState:
## structural base sprite + overlay sprites + shared wear shader.
## Reads ONLY the visual state; it never changes simulation data, and the
## quality profile only changes what is drawn (docs/living_assets/TECHNICAL_INTEGRATION.md).
##
## Files: assets/penzilla/states/ (generated by tools/assets/make_living_states.py,
## private) and its manifest states.json (version 2). Missing files fall back
## to fewer overlays / the original – never an error in the game.

const STATES_DIR := "res://assets/penzilla/states/"
const MANIFEST := STATES_DIR + "states.json"

## Quality profiles. Reference device for "ultra": iPhone 15 Pro Max.
## The simulation is identical in every profile – only drawing differs.
const PROFILES := {
	"ultra": {"label": "Ultra", "shader": true, "max_overlays": 6, "particles": 1.0, "animated_fire": true, "weather_overlays": true},
	"hoch": {"label": "Hoch", "shader": true, "max_overlays": 4, "particles": 0.6, "animated_fire": true, "weather_overlays": true},
	"leistung": {"label": "Leistung", "shader": false, "max_overlays": 2, "particles": 0.25, "animated_fire": false, "weather_overlays": false},
}
## When an overlay budget applies, story-relevant traits win.
const PRIORITY := ["damage_2", "damage_1", "fire_2", "fire_1", "repair_2", "wear_3", "repair_1", "wear_2", "overgrowth_2", "overgrowth_1", "snow_1"]

static var _manifest: Dictionary = {}
static var _loaded := false
static var _materials := {}


static func manifest() -> Dictionary:
	if not _loaded:
		_loaded = true
		if FileAccess.file_exists(MANIFEST):
			var parsed = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST))
			if parsed is Dictionary and int(parsed.get("version", 0)) == 2:
				_manifest = parsed
	return _manifest


static func set_manifest_for_tests(m: Dictionary) -> void:
	_manifest = m
	_loaded = true


static func has_asset(key: String) -> bool:
	return manifest().get("assets", {}).has(key)


## Pure decision (testable without textures): which base, which overlays,
## which shader parameters for an asset, state, weather and profile.
## weather: {"snow": bool}
static func resolve(key: String, state: VisualState, profile := "hoch", weather := {}) -> Dictionary:
	var m := manifest()
	var entry: Dictionary = m.get("assets", {}).get(key, {})
	var prof: Dictionary = PROFILES.get(profile, PROFILES["hoch"])
	var out := {"base": "", "pad_src": [0, 0], "layers": [], "shader": null, "structure": "intact"}
	if entry.is_empty() or entry.get("category", "") == "surface":
		return out
	var bases: Dictionary = entry.get("bases", {})
	var structure: String = state.structure
	if structure != "intact" and not bases.has(structure):
		structure = "intact"   # profile has no such base (e.g. a hydrant has no "ruin")
	out["structure"] = structure
	if structure != "intact":
		out["base"] = bases[structure]["file"]
		out["pad_src"] = bases[structure].get("pad_src", [0, 0])
	var wanted: Array = state.layer_names()
	if weather.get("snow", false) and prof["weather_overlays"]:
		wanted.append("snow_1")
	var allowed: Array = m.get("allowed", {}).get(structure, [])
	var layers: Dictionary = entry.get("layers", {})
	var picked := []
	for name in PRIORITY:
		if not wanted.has(name) or not layers.has(name):
			continue
		if entry.get("profile", "") in ["building", "tent"] and not allowed.has(name):
			continue
		var info: Dictionary = layers[name]
		if structure in info.get("skip_on", []):
			continue
		picked.append(name)
	picked = picked.slice(0, int(prof["max_overlays"]))
	# draw order = generation order (wear under damage under fire …)
	var order: Array = m.get("layer_order", PRIORITY)
	picked.sort_custom(func(a, b): return order.find(a) < order.find(b))
	for name in picked:
		var info: Dictionary = layers[name]
		var file: String = info["file"]
		var off: Array = info["offset_src"]
		if info.get("own", {}).has(structure):
			file = info["own"][structure]["file"]
			off = info["own"][structure]["offset_src"]
		elif info.get("clipped", {}).has(structure):
			file = info["clipped"][structure]
		out["layers"].append({"name": name, "file": file, "offset_src": off})
	if prof["shader"] and structure in ["intact", "partial"]:
		out["shader"] = state.shader_params()
	return out


## Builds the node tree. Coordinates are SOURCE pixels of the original
## canvas (top-left = 0,0); the caller scales the returned node like the
## original sprite (e.g. Iso.WORLD_PER_SRC_PX) and places it at the same spot.
## original: the game's original texture (drawn when the base is "intact").
static func build(key: String, state: VisualState, original: Texture2D, profile := "hoch", weather := {}) -> Node2D:
	var r := resolve(key, state, profile, weather)
	var root := Node2D.new()
	root.name = "LivingVisual"
	var file_scale := float(manifest().get("file_scale", 0.5))
	var entry: Dictionary = manifest().get("assets", {}).get(key, {})
	if original == null and entry.has("original") and ResourceLoader.exists(STATES_DIR + entry["original"]):
		original = load(STATES_DIR + entry["original"])   # assets not used in the game yet (vehicles …)
	var base_tex: Texture2D = original
	var pad: Array = r["pad_src"]
	if r["base"] != "" and ResourceLoader.exists(STATES_DIR + r["base"]):
		base_tex = load(STATES_DIR + r["base"])
	else:
		pad = [0, 0]
	if base_tex == null:
		return root
	var base := Sprite2D.new()
	base.centered = false
	base.texture = base_tex
	# the game's originals are imported at the same file scale
	base.scale = Vector2.ONE / file_scale
	base.position = Vector2(-float(pad[0]), -float(pad[1]))
	if r["shader"] != null:
		base.material = wear_material(r["shader"])
	root.add_child(base)
	for l in r["layers"]:
		var path: String = STATES_DIR + l["file"]
		if not ResourceLoader.exists(path):
			continue
		var s := Sprite2D.new()
		s.centered = false
		s.texture = load(path)
		s.scale = Vector2.ONE / file_scale
		s.position = Vector2(float(l["offset_src"][0]), float(l["offset_src"][1]))
		# overlays stay unshaded: the shader's field is relative to each
		# texture, so dirt would not line up across separate sprites
		s.set_meta("living_layer", l["name"])
		root.add_child(s)
	root.set_meta("resolved", r)
	return root


## One shared material per quantised wear level → sprites keep batching.
static func wear_material(p: Vector3) -> ShaderMaterial:
	var key := "%.2f_%.2f_%.2f" % [p.x, p.y, p.z]
	if not _materials.has(key):
		var m := ShaderMaterial.new()
		m.shader = preload("res://shaders/living_wear.gdshader")
		m.set_shader_parameter("grime_tex", preload("res://assets/vfx/grime_field.png"))
		m.set_shader_parameter("dirt", p.x)
		m.set_shader_parameter("fade", p.y)
		m.set_shader_parameter("darken", p.z)
		_materials[key] = m
	return _materials[key]


## Surface overlays (shared per surface family, e.g. all 9 road tiles).
static func surface_overlay(key: String, state: String) -> Dictionary:
	var m := manifest()
	var entry: Dictionary = m.get("assets", {}).get(key, {})
	var fam: Dictionary = m.get("surface_families", {}).get(entry.get("family", ""), {})
	return fam.get("layers", {}).get(state, {})
